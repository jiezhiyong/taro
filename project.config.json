{
  "description": "微信开发者工具项目配置示例，详见文档：https://developers.weixin.qq.com/miniprogram/dev/devtools/projectconfig.html",
  "miniprogramRoot": "dist/",
  "srcMiniprogramRoot": "dist/",
  "compileType": "miniprogram",
  "appid": "touristappid",
  "projectname": "taro-showcase",
  "setting": {
    "urlCheck": true,
    "es6": true,
    "postcss": false,
    "minified": true,
    "newFeature": true,
    "coverView": true,
    "lazyloadPlaceholderEnable": false,
    "preloadBackgroundData": false,
    "autoAudits": false,
    "uglifyFileName": false,
    "uploadWithSourceMap": true,
    "enhance": true,
    "showShadowRootInWxmlPanel": true,
    "packNpmManually": false,
    "packNpmRelationList": [],
    "minifyWXSS": true,
    "useStaticServer": true,
    "showES6CompileOption": false,
    "checkInvalidKey": true,
    "checkSiteMap": true,
    "ignoreUploadUnusedFiles": true,
    "babelSetting": {
      "ignore": [],
      "disablePlugins": [],
      "outputPath": ""
    },
    "disableUseStrict": false,
    "useCompilerPlugins": false,
    "minifyWXML": true
  },
  "libVersion": "latest",
  "packOptions": {
    "ignore": [
      {
        "type": "folder",
        "value": "node_modules"
      },
      {
        "type": "folder",
        "value": "src"
      },
      {
        "type": "folder",
        "value": "config"
      },
      {
        "type": "file",
        "value": "README.md"
      }
    ],
    "include": []
  },
  "condition": {
    "miniprogram": {
      "list": []
    }
  },
  "editorSetting": {
    "tabIndent": "insertSpaces",
    "tabSize": 2
  }
}